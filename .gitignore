node_modules/
*.tmp.js
*.tmp
.DS_Store
npm-debug.log*
/tmp/
.env
.env.*

# PP-OCRv6 sidecar — isolated venv + model cache (never committed)
scripts/v3/ocr/.venv/
scripts/v3/ocr/.models/

# research PDFs — local reference only, never tracked
# (ignore refs/ contents, but keep the trusted-tester extraction tracked — use refs/*
#  not refs/ so git descends into the dir and the negation below can take effect)
refs/*
!refs/trusted-tester/

# assets
assets/Description*/
assets/lovable/
assets/mock-old/
# the real-page CORPUS (large, regenerable) — local only. Synthetic TEST fixtures live in
# assets/fixtures/ (tracked); see scripts/v3/tests + run-evaluation.js resolveUrl.
assets/saved/

# FN×LLM eval-run outputs: keep the small analysis artifacts (results/summary/diagnosis) tracked, but the
# full LLM reasoning trace (megabytes) and the live monitor status file are large/transient — local only.
results/fn-llm/llm-trace.json
results/fn-llm/status.json
results/fn-llm/traces/
